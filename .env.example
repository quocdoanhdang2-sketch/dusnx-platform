# =============================================================================
# DUSN-X — Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your local setup.
# =============================================================================

# ── AI API & Core Model ───────────────────────────────────────────────────────
# Path to DUSN-X routing model checkpoint (PyTorch .pt)
DUSNX_CHECKPOINT=artifacts/dusnx_smoke_v2.pt

# Device for neural network inference: "cpu", "cuda", or "auto"
DUSNX_DEVICE=auto

# Persistent SQLite database directory (auth.db, memory.db)
# Native default preserves python/data. For Docker use the existing container volume path.
DUSNX_DATA_DIR=python/data
DUSNX_GATEWAY_DATA_DIR=runtime/gateway-data
DUSNX_AI_PORT=8000
DUSNX_GATEWAY_PORT=8080
DUSNX_GATEWAY_TIMEOUT=90

# Token session validity period in seconds (default 86400 = 24h) or hours (DUSNX_TOKEN_TTL_HOURS)
DUSNX_TOKEN_TTL_SECONDS=86400
# DUSNX_TOKEN_TTL_HOURS=24

# ── LLM Provider Configuration ─────────────────────────────────────────────────
# Provider to use: "ollama" (recommended) or "openai" / "openai_compatible"
DUSNX_PROVIDER=ollama

# Ollama settings (run: ollama pull qwen2.5:0.5b)
# When running native: http://localhost:11434
# When running AI API in Docker container accessing host Ollama: http://host.docker.internal:11434
DUSNX_OLLAMA_URL=http://localhost:11434
DUSNX_OLLAMA_MODEL=qwen2.5:0.5b
# Candidate is evaluation/experimental only; base remains the default.
DUSNX_ENABLE_LLM_EVAL=0
# DUSNX_LLM_EVAL_MODELS=qwen2.5:0.5b,dusnx-vi-candidate
DUSNX_OLLAMA_TIMEOUT=60.0


# Optional fallback: OpenAI-compatible endpoint (LM Studio, vLLM, OpenAI, etc.)
# Primary names: DUSNX_OPENAI_BASE_URL and DUSNX_OPENAI_API_KEY (aliases: DUSNX_OPENAI_URL, DUSNX_OPENAI_KEY)
DUSNX_OPENAI_BASE_URL=http://localhost:1234/v1
DUSNX_OPENAI_MODEL=llama3.2
DUSNX_OPENAI_API_KEY=optional-key

# ── Gateway (.NET 8) Configuration ───────────────────────────────────────────
# Base URL of the Python AI API service for the reverse proxy
AI_API_URL=http://localhost:8000

# Optional: Custom directory for Web UI static files
DUSNX_WEB_UI_DIR=web-ui

# Optional: Allow remote dev history inspection (default false = loopback only)
DUSNX_ALLOW_REMOTE_DEV_HISTORY=false

# ── Webhooks (Phase 2) ────────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
ZALO_WEBHOOK_SECRET=replace-before-enabling-cloudflare-tunnel
